{
    "name": "@frontlit/page-builder",
    "version": "0.1.0",
    "description": "Block-based WYSIWYG page builder and renderer for FrontLit",
    "private": true,
    "license": "MIT",
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./models": "./dist/models/index.js",
        "./primitives": "./dist/primitives/index.js",
        "./components": "./dist/components/index.js",
        "./blocks": "./dist/blocks/index.js",
        "./renderer": "./dist/renderer/index.js",
        "./builder": "./dist/builder/index.js",
        "./styles.css": "./dist/styles.css",
        "./theme.css": "./src/theme.css"
    },
    "types": "./dist/index.d.ts",
    "typesVersions": {
        "*": {
            "models": ["dist/models/index.d.ts"],
            "primitives": ["dist/primitives/index.d.ts"],
            "components": ["dist/components/index.d.ts"],
            "blocks": ["dist/blocks/index.d.ts"],
            "renderer": ["dist/renderer/index.d.ts"],
            "builder": ["dist/builder/index.d.ts"]
        }
    },
    "scripts": {
        "build": "tsup && node scripts/add-use-client.mjs && tailwindcss -i src/styles.css -o dist/styles.css",
        "dev": "tsup --watch",
        "clean": "rimraf dist",
        "check-types": "tsc --noEmit"
    },
    "peerDependencies": {
        "next": "^15.0.0 || ^16.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0"
    },
    "dependencies": {
        "@frontlit/text-editor": "workspace:*",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "color-convert": "^3.1.0",
        "lucide-react": "^0.553.0",
        "tailwind-merge": "^3.4.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@types/color-convert": "^2.0.4",
        "@types/node": "^20.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@tailwindcss/cli": "^4.1.0",
        "rimraf": "^5.0.0",
        "tailwindcss": "^4.1.0",
        "tsup": "^8.3.0",
        "typescript": "^5.6.2"
    }
}
