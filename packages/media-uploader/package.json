{
  "name": "@frontlit/media-uploader",
  "version": "0.1.0-alpha.0",
  "description": "Reusable media and file upload dialog with library and Unsplash tabs for React",
  "author": "FrontLit",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codelitdev/frontlit.git",
    "directory": "packages/media-uploader"
  },
  "homepage": "https://github.com/codelitdev/frontlit/tree/main/packages/media-uploader",
  "bugs": {
    "url": "https://github.com/codelitdev/frontlit/issues"
  },
  "keywords": [
    "react",
    "media",
    "uploader",
    "image-upload",
    "file-upload",
    "unsplash",
    "frontlit"
  ],
  "scripts": {
    "build": "tsup && node scripts/add-use-client.mjs && tailwindcss -i src/styles.css -o dist/styles.css",
    "prepublishOnly": "bun run build",
    "dev": "tsup --watch",
    "clean": "rimraf dist",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^5.6.2"
  }
}
