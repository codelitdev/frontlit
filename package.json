{
  "name": "frontlit",
  "version": "1.0.0",
  "description": "The frontoffice of your SaaS",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": ">=1.4.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "qs": "6.16.0",
    "ts-deepmerge": "8.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "brace-expansion@>=1.0.0 <2.0.0": "1.1.21",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
    "fast-uri": "3.1.9",
    "image-size": "2.0.3",
    "ip-address": "10.7.4",
    "next": "16.4.1",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "vitest@>=4.0.0 <5.0.0": "4.1.12",
    "@modelcontextprotocol/server@>=2.0.0 <3.0.0": "2.3.0",
    "hono@>=4.0.0 <5.0.0": "4.13.11",
    "nodemailer@>=10.0.0 <11.0.0": "10.1.4",
    "vite@>=7.0.0 <8.0.0": "7.3.7",
    "undici@>=7.0.0 <8.0.0": "7.30.1",
    "undici@>=6.0.0 <7.0.0": "6.29.1",
    "body-parser@>=1.0.0 <2.0.0": "1.20.9",
    "body-parser@>=2.0.0 <3.0.0": "2.4.0",
    "zod@>=4.0.0 <5.0.0": "4.6.7"
  },
  "patchedDependencies": {
    "@anatine/zod-openapi@1.14.2": "patches/@anatine__zod-openapi@1.14.2.patch"
  },
  "scripts": {
    "dev": "bun --filter @frontlit/api --filter @frontlit/web --filter @frontlit/sites dev",
    "dev:api": "bun --filter @frontlit/api dev",
    "dev:web": "bun --filter @frontlit/web dev",
    "dev:docs": "bun --filter @frontlit/docs dev",
    "dev:sites": "bun --filter @frontlit/sites dev",
    "build": "bun run --workspaces --if-present build",
    "typecheck": "bun run --workspaces --if-present check-types",
    "lint": "bun run --workspaces --if-present lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "husky",
    "test": "bun run --workspaces --if-present test",
    "check:drift": "bun run --filter @frontlit/api check:drift",
    "changeset": "changeset",
    "release": "bun run --filter @frontlit/text-editor --filter @frontlit/media-uploader build && bun run --filter @frontlit/page-builder build && node scripts/resolve-workspace-ranges.mjs && changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "^2.29.7",
    "@types/bun": "1.4.1",
    "eslint": "^9.12.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.2",
    "typescript-eslint": "^8.46.0"
  }
}
