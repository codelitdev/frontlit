{
    "name": "frontlit",
    "version": "1.0.0",
    "description": "The frontoffice of your SaaS",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*",
        "examples/*"
    ],
    "scripts": {
        "dev": "pnpm --parallel --filter @frontlit/api --filter @frontlit/web --filter @frontlit/sites run dev",
        "dev:api": "pnpm --filter @frontlit/api dev",
        "dev:web": "pnpm --filter @frontlit/web dev",
        "dev:docs": "pnpm --filter @frontlit/docs dev",
        "dev:sites": "pnpm --filter @frontlit/sites dev",
        "build": "pnpm -r run build",
        "lint": "eslint packages apps --quiet",
        "prettier": "prettier --write packages apps *.md",
        "prepare": "husky",
        "test": "pnpm -r run test",
        "ci:publish": "pnpm publish -r --no-git-checks"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.22.0",
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "eslint": "^9.12.0",
        "eslint-config-next": "16.3.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-unused-imports": "^4.3.0",
        "globals": "^15.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.2.2",
        "prettier": "^3.0.2",
        "typescript-eslint": "^8.46.0"
    },
    "pnpm": {
        "overrides": {
            "@types/react": "19.2.18",
            "@types/react-dom": "19.2.4",
            "postcss@<8.5.10": ">=8.5.23 <9",
            "postcss@<=8.5.11": ">=8.5.23 <9",
            "postcss@<=8.5.17": ">=8.5.23 <9",
            "postcss@<=8.5.22": ">=8.5.23 <9",
            "fast-uri@>=3.0.0": ">=3.1.8 <4",
            "next@>=16.0.0": ">=16.3.6 <17",
            "brace-expansion@<2": ">=1.1.21 <2",
            "brace-expansion@>=2 <3": ">=2.1.7 <3",
            "brace-expansion@>=4 <6": ">=5.0.12 <6",
            "ip-address@>=10": ">=10.7.1 <11",
            "hono@<5": ">=4.13.5 <5",
            "js-yaml@>=3 <4": ">=3.15.2 <4",
            "js-yaml@>=4 <5": ">=4.3.2 <5",
            "nanoid@>=3 <4": ">=3.3.18 <4",
            "@hono/node-server@<2": ">=1.19.15 <2",
            "fast-xml-parser@>=5": ">=5.10.1 <6",
            "qs@>=2": ">=6.16.0 <7",
            "@tiptap/core@>=3": ">=3.30.5 <4",
            "baseline-browser-mapping@>=2 <2.11.0": ">=2.11.0 <3",
            "sharp@>=0.35.0 <0.35.4": ">=0.35.4 <0.36",
            "nodemailer@>=9 <10": ">=9.1.1 <10",
            "image-size@>=2": ">=2.0.3 <3",
            "undici@>=7 <8": ">=7.29.1 <8",
            "proxy-addr@<3": ">=2.0.8 <3",
            "source-map-js@<2": ">=1.2.2 <2",
            "postcss-selector-parser@>=7 <8": ">=7.1.6 <8",
            "prosemirror-view@<2": ">=1.42.3 <2",
            "@modelcontextprotocol/sdk@>=1 <2": ">=1.31.0 <2",
            "esbuild@>=0.27.3 <0.28.1": ">=0.28.1 <0.29"
        }
    },
    "type": "module"
}
