# The base URL of the FrontLit API (apps/api). Server-side only — never
# exposed to the browser. All requests from the browser go through this
# app's own /api/proxy and /api/auth routes, which forward the session
# cookie as-is.
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

# Must match this app's own public origin.
WEB_CLIENT=http://localhost:3000
