{
    "name": "@frontlit/api",
    "version": "0.1.0",
    "private": true,
    "description": "Better Auth protected REST API for building and serving pages — the FrontLit backend",
    "license": "MIT",
    "main": "dist/index.js",
    "files": [
        "dist",
        "drizzle"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "nodemon --exec 'node --env-file=.env --import tsx' src/index.ts",
        "start": "node dist/index.js",
        "db:migrate": "node dist/db/migrate.js",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "check-types": "tsc -p tsconfig.test.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@ai-sdk/amazon-bedrock": "^5.0.54",
        "@ai-sdk/anthropic": "^4.0.23",
        "@ai-sdk/azure": "^3.0.99",
        "@ai-sdk/openai": "^4.0.23",
        "@aws-sdk/client-s3": "^3.1111.0",
        "@better-auth/cimd": "1.7.0-rc.4",
        "@better-auth/oauth-provider": "1.7.0-rc.4",
        "@codelitdev/oauth-server-kit": "0.1.0-alpha.0",
        "@frontlit/api-contract": "workspace:*",
        "@modelcontextprotocol/node": "^2.0.0",
        "@modelcontextprotocol/server": "^2.0.0",
        "@openrouter/ai-sdk-provider": "^3.0.0",
        "@ts-rest/express": "^3.52.1",
        "@ts-rest/open-api": "^3.52.1",
        "ai": "^7.0.41",
        "ai-sdk-provider-opencode-sdk": "^4.1.0",
        "better-auth": "1.7.0-rc.4",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "drizzle-orm": "^0.45.2",
        "express": "^4.21.2",
        "express-rate-limit": "^7.5.0",
        "medialit": "0.2.0",
        "nanoid": "^5.1.6",
        "nodemailer": "^9.0.1",
        "pg": "^8.13.1",
        "pino": "^10.1.0",
        "swagger-ui-express": "^5.0.1",
        "uuidv7": "^1.0.2",
        "ws": "^8.21.3",
        "zod": "^3.25.76",
        "zod-to-json-schema": "^3.25.2"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.2.17",
        "@modelcontextprotocol/client": "^2.0.0",
        "@types/cors": "^2.8.12",
        "@types/express": "^4.17.20",
        "@types/node": "^22.14.1",
        "@types/nodemailer": "^6.4.17",
        "@types/pg": "^8.11.10",
        "@types/swagger-ui-express": "^4.1.8",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "^0.28.1",
        "nodemon": "^3.1.10",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    }
}
