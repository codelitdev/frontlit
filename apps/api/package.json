{
  "name": "@frontlit/api",
  "version": "0.1.0",
  "private": true,
  "description": "Better Auth protected REST API for building and serving pages — the FrontLit backend",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch --env-file=.env src/index.ts",
    "start": "node dist/index.js",
    "db:migrate": "node dist/db/migrate.js",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check-types": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "generate:auth-schema": "node scripts/generate-auth-schema.mjs",
    "check:auth-schema": "node scripts/generate-auth-schema.mjs --check",
    "generate:billing": "codelit-billing generate --config billing.config.ts",
    "check:billing-schema": "codelit-billing generate --check --config billing.config.ts",
    "check:drift": "bun run check:auth-schema && bun run check:billing-schema",
    "test:docs-postgres": "node --env-file=.env --import tsx scripts/test-docs-postgres.ts",
    "docs:deletion-ledger": "node --env-file=.env --import tsx src/documentation/deletion-ledger-cli.ts",
    "test:docs-restore-postgres": "node --env-file=.env --import tsx scripts/test-docs-postgres.ts --backup-restore",
    "test:docs-outbox-postgres": "node --env-file=.env --import tsx scripts/test-docs-postgres.ts --outbox-crash",
    "test:docs-media-postgres": "node --env-file=.env --import tsx scripts/test-docs-postgres.ts --media-race",
    "test:docs-editor-postgres": "node --env-file=.env --import tsx scripts/test-docs-postgres.ts --editor-no-github",
    "test:docs-tenant-burst-postgres": "node --env-file=.env --import tsx scripts/test-docs-postgres.ts --tenant-burst",
    "test:docs-adoption-race-postgres": "node --env-file=.env --import tsx scripts/test-docs-postgres.ts --adoption-transport-race"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^5.0.54",
    "@ai-sdk/anthropic": "^4.0.23",
    "@ai-sdk/azure": "^3.0.99",
    "@ai-sdk/openai": "^4.0.23",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@better-auth/cimd": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@codelitdev/mcp-server-kit": "0.1.0-alpha.0",
    "@codelitdev/oauth-server-kit": "0.1.0-alpha.0",
    "@codelitdev/observability": "0.1.0-alpha.0",
    "@codelitdev/platform": "0.1.0-alpha.0",
    "@frontlit/api-contract": "workspace:*",
    "@frontlit/text-editor": "workspace:*",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@ts-rest/express": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "ai": "^7.0.41",
    "ai-sdk-provider-opencode-sdk": "^4.1.0",
    "better-auth": "1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "medialit": "0.2.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^9.0.1",
    "pg": "^8.13.1",
    "pino": "^10.1.0",
    "swagger-ui-express": "^5.0.1",
    "uuidv7": "^1.0.2",
    "ws": "^8.21.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@codelitdev/billing": "0.1.0-alpha.4",
    "@codelitdev/platform-conformance": "0.1.0-alpha.0",
    "@electric-sql/pglite": "^0.2.17",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.20",
    "@types/node": "^22.14.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
