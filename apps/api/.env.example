# Postgres connection string. docker-compose.local.yml publishes Postgres
# on loopback port 5433 (the container still listens on 5432).
DB_CONNECTION_STRING=postgres://frontlit:frontlit@localhost:5433/frontlit

# Port the API listens on.
PORT=4000

# Better Auth's session/cookie signing secret. Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# This app's own public origin. Falls back to http://localhost:4000.
API_PUBLIC_URL=http://localhost:4000

# Set to true only when the API is reached through exactly one trusted reverse
# proxy hop (for example, a local Tailscale Funnel proxying to this process).
# This lets Express and express-rate-limit use X-Forwarded-For correctly.
ENABLE_TRUST_PROXY=false

# Shared secret required on the X-Frontlit-Provisioning-Secret header for
# POST /provisioning/teams.
PROVISIONING_SECRET=

# The web app's public origin — allowlisted as a Better Auth trusted origin
# and used to build the post-login redirect. Must match apps/web's own
# WEB_CLIENT env var.
WEB_CLIENT=http://localhost:3000

# Optional: shared parent domain for cross-subdomain session cookies in
# production (e.g. frontlit.example.com, covering both app. and api.
# subdomains). Leave unset in local dev.
AUTH_COOKIE_DOMAIN=

# Platform system mail (login OTPs). Only used when NODE_ENV=production —
# in development the OTP is logged instead of emailed.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Visible From: Team Support <support@<subdomain>.<MAIL_DOMAIN>>
MAIL_DOMAIN=frontlit.app
MAIL_SUPPORT_LOCAL_PART=support
# Dedicated inbound MX host. Reply-To becomes reply+<token>@this-domain.
# Leave unset to keep Reply-To on support@ (local/Mailpit).
INBOUND_EMAIL_DOMAIN=replies.frontlit.app
# SES inbound (S3 + SNS). All three required to enable /webhooks/inbound-email/ses.
EMAIL_SES_TOPIC_ARN=
EMAIL_SES_BUCKET=
EMAIL_SES_REGION=
EMAIL_SES_PREFIX=

# Optional Google social sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: auto-provisions one super-admin account + team + API key on
# boot if no account exists for this email yet. Dev/self-host convenience.
SUPER_ADMIN_EMAIL=

LOG_LEVEL=info
NODE_ENV=development

# Inbox AI. Set false to stop new provider calls; in-flight final writes discard.
INBOX_AI_ENABLED=true
# Shared Chatbot + Tickets daily token budget per team (UTC day).
INBOX_AI_DAILY_TOKEN_BUDGET=100000

# MediaLit — server-side credentials for the media/upload module. FrontLit
# holds these; the browser only ever sees a short-lived upload signature
# (see src/media/service.ts).
MEDIALIT_APIKEY=
MEDIALIT_SERVER=https://api.medialit.cloud

# Optional. Server-side Unsplash access key for the image picker's search
# tab. Never expose this to the browser or bake it into the web image.
# When unset, the picker falls back to a pasted Unsplash URL.
UNSPLASH_ACCESS_KEY=

# Symmetric key used to encrypt third-party integration secrets (e.g. a
# GitHub PAT) at rest in the `integrations.config` jsonb column. Falls back
# to BETTER_AUTH_SECRET in dev if unset — set a dedicated one in production.
INTEGRATIONS_ENCRYPTION_KEY=

# SendLit (architecture.md §10.1) — email/lead-capture + help-desk
# transactional email. Points at either the hosted SendLit instance or a
# self-hosted one running alongside FrontLit (§10.4). Email/ticket
# email features silently no-op if unset.
SENDLIT_API_URL=http://localhost:3001
# Scoped SendLit organization API key for POST /provisioning/teams. For
# local Compose, retrieve the one-time `organizationApiKey` from:
#   docker compose -f docker-compose.local.yml logs sendlit-api
# For the self-host stack, use `docker compose logs sendlit-api`.
SENDLIT_ORGANIZATION_API_KEY=
# Keep retrying `provision_sendlit` outbox jobs after 8 failures (default true).
# Set false to mark them `failed` like other outbox types.
# SENDLIT_PROVISION_RETRY_FOREVER=true

# Base URL for apps/sites, used to build magic-link ticket thread URLs in
# help-desk notification emails (architecture.md §11.2). Falls back to
# http://localhost:3002.
SITES_BASE_URL=http://localhost:3002
# Base URL for apps/web (the dashboard), used to build "view in dashboard"
# links in help-desk notification emails. Falls back to http://localhost:3000.
WEB_BASE_URL=http://localhost:3000

# Public-site hostname suffix. The API is the sole authority that classifies
# `<slug>.<suffix>` hosts and resolves the slug against teams.subdomain.
# Use `localhost` locally and `frontlit.app` in production.
PLATFORM_SITE_DOMAIN=localhost

# Optional: FrontLit's own team id, for dogfooding. This team may claim
# reserved subdomains (e.g. `frontlit`) and attach PLATFORM_SITE_DOMAIN itself
# (plus its www.) as its custom domain.
PLATFORM_TEAM_ID=

# DNS CNAME target shown when a team attaches a custom domain. Keep this
# separate from PLATFORM_SITE_DOMAIN because the serving edge may use a
# different hostname. Defaults to sites.<PLATFORM_SITE_DOMAIN> when unset.
CUSTOM_DOMAIN_CNAME_TARGET=sites.localhost
# Apex custom domains (example.com) can't use a CNAME, so they are shown as A
# records to these IPs (comma- or space-separated) — set this to the serving
# edge's static IP(s). Verification requires the apex A set to match. If unset,
# apex domains show no A records and only need to resolve.
CUSTOM_DOMAIN_A_RECORDS=
# Relative TXT owner label used when a team has no provisioned override.
CUSTOM_DOMAIN_TXT_RECORD_NAME=_frontlit-verify

# Cloudflare Turnstile CAPTCHA on public writes (/leads, /tickets, ticket
# replies — architecture.md §13.3). Defaults to "turnstile" once a secret is
# set, otherwise "none" (honeypot-only) — set explicitly to "none" to force
# honeypot-only even with a secret configured.
CAPTCHA_PROVIDER=
TURNSTILE_SECRET_KEY=

# Shared HMAC secret for the ISR revalidation webhook apps/api pings on
# publish/domain/settings changes (architecture.md §12.2). Must match
# apps/sites' own REVALIDATE_WEBHOOK_SECRET. Unset = no invalidations are
# sent and public pages refresh once a minute instead of on publish.
REVALIDATE_WEBHOOK_SECRET=
# Where cache invalidations are posted, when apps/sites is reachable on an
# internal address (e.g. http://frontlit-sites:3002). Defaults to
# SITES_BASE_URL.
SITES_REVALIDATE_URL=

# Edge cache purging, when apps/sites runs with EDGE_CACHE_MODE=purge
# (docs/site-delivery.md §5, deploy/edge-cache). The http adapter POSTs
# { teamId, tags } signed with EDGE_PURGE_SECRET to EDGE_PURGE_URL.
EDGE_PURGE_ADAPTER=http
EDGE_PURGE_URL=
EDGE_PURGE_SECRET=
# EDGE_PURGE_ADAPTER=cloudflare (hosted FrontLit): the zone custom hostnames
# live in and a token with the Zone → Cache Purge permission.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# AI providers and credentials are configured per team in Settings → AI.

# Documentation GitHub App. See docs/docs-management.md (operations runbook).
# Keep these server-only; the callback must match the GitHub registration.
GITHUB_DOCS_APP_ID=
GITHUB_DOCS_APP_SLUG=
GITHUB_DOCS_CLIENT_ID=
GITHUB_DOCS_CLIENT_SECRET=
GITHUB_DOCS_PRIVATE_KEY=
GITHUB_DOCS_WEBHOOK_SECRET=
GITHUB_DOCS_CALLBACK_URL=
GITHUB_DOCS_WEB_ORIGIN=http://localhost:3000

# Hold documentation serving/imports/Git writes during backup restoration.
# Leave true until an independently retained deletion ledger has been replayed.
# Replay all ledger batches and verify restrictions before explicitly clearing.
DOCS_RESTORE_PENDING=false

# Required for irreversible documentation purge. Private durable POSIX storage,
# independent of database backups and shared by every API/worker instance.
# Supports atomic hard links and file/directory fsync; never use a temporary dir.
DOCS_DELETION_LEDGER_DIR=
