# Postgres connection string.
DB_CONNECTION_STRING=postgres://frontlit:frontlit@localhost:5432/frontlit

# Port the API listens on.
PORT=4000

# Better Auth's session/cookie signing secret. Must be at least 32 bytes.
# Generate one with: openssl rand -base64 48
BETTER_AUTH_SECRET=

# This app's own public origin. Falls back to http://localhost:4000.
API_PUBLIC_URL=http://localhost:4000

# Comma-separated browser origins allowed to call /mcp. The API and WEB_CLIENT
# origins are always included. Desktop/server clients normally send no Origin.
# Add exact hosted playground/inspector origins when they call MCP from a
# browser; wildcards are intentionally unsupported.
MCP_ALLOWED_ORIGINS=

# Set to true only when the API is reached through exactly one trusted reverse
# proxy hop (for example, a local Tailscale Funnel proxying to this process).
# This lets Express and express-rate-limit use X-Forwarded-For correctly.
ENABLE_TRUST_PROXY=false

# Shared secret required on the X-Frontlit-Provisioning-Secret header for
# POST /provisioning/teams.
PROVISIONING_SECRET=

# The web app's public origin — allowlisted as a Better Auth trusted origin
# and used to build the post-login redirect. Must match apps/web's own
# WEB_CLIENT env var.
WEB_CLIENT=http://localhost:3000

# Optional: shared parent domain for cross-subdomain session cookies in
# production (e.g. frontlit.example.com, covering both app. and api.
# subdomains). Leave unset in local dev.
AUTH_COOKIE_DOMAIN=

# Platform system mail (login OTPs). Only used when NODE_ENV=production —
# in development the OTP is logged instead of emailed.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional Google social sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: auto-provisions one super-admin account + team + API key on
# boot if no account exists for this email yet. Dev/self-host convenience.
SUPER_ADMIN_EMAIL=

LOG_LEVEL=info
NODE_ENV=development

# MediaLit — server-side credentials for the media/upload module. FrontLit
# holds these; the browser only ever sees a short-lived upload signature
# (see src/media/service.ts).
MEDIALIT_APIKEY=
MEDIALIT_SERVER=https://api.medialit.cloud

# Symmetric key used to encrypt third-party integration secrets (e.g. a
# GitHub PAT) at rest in the `integrations.config` jsonb column. Falls back
# to BETTER_AUTH_SECRET in dev if unset — set a dedicated one in production.
INTEGRATIONS_ENCRYPTION_KEY=

# SendLit (architecture.md §10.1) — newsletter/lead-capture + help-desk
# transactional email. Points at either the hosted SendLit instance or a
# self-hosted one running alongside FrontLit (§10.4). Newsletter/ticket
# email features silently no-op if unset.
SENDLIT_API_URL=
# Must match SendLit's own PROVISIONING_SECRET env var — required to call
# SendLit's POST /provisioning/teams.
SENDLIT_PROVISIONING_SECRET=

# Base URL for apps/sites, used to build magic-link ticket thread URLs in
# help-desk notification emails (architecture.md §11.2). Falls back to
# http://localhost:3002.
SITES_BASE_URL=http://localhost:3002
# Base URL for apps/web (the dashboard), used to build "view in dashboard"
# links in help-desk notification emails. Falls back to http://localhost:3001.
WEB_BASE_URL=http://localhost:3001

# Public-site hostname suffix. The API is the sole authority that classifies
# `<slug>.<suffix>` hosts and resolves the slug against teams.subdomain.
# Use `localhost` locally and `frontlit.app` in production.
PLATFORM_SITE_DOMAIN=localhost

# DNS CNAME target shown when a team attaches a custom domain. Keep this
# separate from PLATFORM_SITE_DOMAIN because the serving edge may use a
# different hostname. Defaults to sites.<PLATFORM_SITE_DOMAIN> when unset.
CUSTOM_DOMAIN_CNAME_TARGET=sites.localhost

# Cloudflare Turnstile CAPTCHA on public writes (/leads, /tickets, ticket
# replies — architecture.md §13.3). Defaults to "turnstile" once a secret is
# set, otherwise "none" (honeypot-only) — set explicitly to "none" to force
# honeypot-only even with a secret configured.
CAPTCHA_PROVIDER=
TURNSTILE_SECRET_KEY=

# Shared HMAC secret for the ISR revalidation webhook apps/api pings on
# publish/domain/settings changes (architecture.md §12.2). Must match
# apps/sites' own REVALIDATE_WEBHOOK_SECRET. Unset = the webhook ping is
# skipped entirely; apps/sites' 60s time-bound cache still covers the gap.
REVALIDATE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Chat LLM (Vercel AI SDK — architecture.md §7)
# ---------------------------------------------------------------------------
# Provider: opencode-go | openai | anthropic | local
# Unset = auto-detect from which API key is present (OpenCode Go first,
# then OpenAI, then Anthropic). No keys → local extractive fallback.
CHAT_PROVIDER=
# Model id for the active provider. Defaults:
#   opencode-go → deepseek-v4-flash
#   openai      → gpt-4o-mini
#   anthropic   → claude-haiku-4-5-20251001
# OpenCode Go model list: https://opencode.ai/docs/go/#endpoints
CHAT_MODEL=

# OpenCode Go key (https://opencode.ai/auth). Preferred for chat.
# Alias OPENCODE_GO_API_KEY is also accepted.
OPENCODE_API_KEY=
# Optional override of the Go OpenAI-compatible base URL.
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Optional — wire later; used when CHAT_PROVIDER=openai / anthropic
# (also powers doc embeddings when EMBEDDINGS_PROVIDER=openai).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Embeddings provider: openai | local (default: openai if OPENAI_API_KEY set).
# EMBEDDINGS_PROVIDER=
# EMBEDDINGS_MODEL=text-embedding-3-small
