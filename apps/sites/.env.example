# The base URL of the FrontLit API (apps/api). Server-side only — this app
# has no session/auth of its own; every read is an unauthenticated call to
# the API's /public/* surface.
API_URL=http://localhost:4000

# The API's browser-reachable origin, handed to client-side page-builder
# blocks (email-form/support-form) so their fetch() calls from the visitor's
# browser resolve. Defaults to API_URL — only set separately when the
# server-side and public API origins differ.
API_PUBLIC_URL=http://localhost:4000

# Shared HMAC secret for POST /api/webhooks/revalidate, apps/api's ISR
# revalidation ping (architecture.md §12.2). Must match apps/api's own
# REVALIDATE_WEBHOOK_SECRET. Unset = the webhook 404s and cached pages
# refresh once a minute instead of on publish.
REVALIDATE_WEBHOOK_SECRET=

# Optional: Redis shared by every replica of this app (cached pages and data,
# tag invalidations, host lookups). Unset = per-process memory, which is all
# a single instance needs.
REDIS_URL=

# Set the same value on every replica of one release (Next.js deploymentId).
DEPLOYMENT_ID=
