# Secrets required by the self-hosted SendLit API in docker-compose.yml.
# Generate each independently, for example: openssl rand -base64 48
SENDLIT_BETTER_AUTH_SECRET=
SENDLIT_PIXEL_SIGNING_SECRET=
SENDLIT_ESP_CREDENTIALS_ENCRYPTION_KEY=
SENDLIT_SUPPRESSION_HASH_KEY=

# On first boot, SendLit creates this administrator's default organization and
# logs a one-time scoped organization API key. Put that key in FrontLit's
# apps/api/.env as SENDLIT_ORGANIZATION_API_KEY.
SENDLIT_SUPER_ADMIN_EMAIL=

# Public URLs used by SendLit when it runs behind a reverse proxy. The defaults
# in docker-compose.yml are suitable for local development.
# SENDLIT_NODE_ENV=production
# SENDLIT_API_PUBLIC_URL=https://sendlit-api.example.com
# SENDLIT_WEB_CLIENT=https://sendlit.example.com
# SENDLIT_PROTOCOL=https
# SENDLIT_DOMAIN=sendlit.example.com
